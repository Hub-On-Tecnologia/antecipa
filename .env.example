# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Access token gate config (servidor)
# ACCESS_TOKEN="seu_token_secreto_no_servidor"

# Chave entregue ao backend do app parceiro para emitir codigos de acesso via
# POST /api/access-tokens (header X-Integration-Key). Minimo de 32 caracteres.
# Permite APENAS emitir codigo — nenhum acesso a dado de corretor ou ao banco.
# Assim o parceiro nunca precisa da chave de service account do Firebase, que
# seria administrador total do projeto.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_API_KEY=""

# Bitrix24 Webhook settings (Servidor Node/Proxy - Não expor no cliente VITE_)
BITRIX_WEBHOOK_WRITE_URL="https://seu-dominio.bitrix24.com.br/rest/USER_ID/TOKEN/crm.deal.add.json"
BITRIX_LIST_URL="https://seu-dominio.bitrix24.com.br/rest/USER_ID/TOKEN/crm.deal.list.json"
BITRIX_WEBHOOK_URL="https://seu-dominio.bitrix24.com.br/rest/USER_ID/TOKEN/crm.deal.add.json"

# Firebase applet configurations
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
# ATENÇÃO: se o projeto usa um Firestore NOMEADO (não "(default)"), este ID é
# obrigatório também no servidor. Sem ele o Admin SDK aponta para "(default)",
# que não existe, e todo endpoint que usa Firestore devolve 500.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Google Sheets Configuration
VITE_SHEET_ID="ID_DA_SUA_PLANILHA_GOOGLE"
VITE_SHEET_TAB_USUARIOS="usuários"
VITE_SHEET_TAB_CR="CR 2025"

# Conexão DB-API (Proxy MariaDB via WireGuard)
DB_API_URL="http://10.0.3.2:8000"
DB_API_KEY="sua_api_key_do_db_api"


# --- Autenticação por e-mail e senha (.docs/PLANO_AUTH_EMAIL_SENHA.md) ---
# Interruptor geral. Com "0" ou ausente, os endpoints de cadastro e recuperação
# respondem 503 e nada é criado. Só ligar depois de habilitar o provedor
# E-mail/senha no Console do Firebase (Task 2).
AUTH_SENHA_ENABLED="0"
# Domínio do identificador sintético derivado do CPF. NÃO deve receber e-mail
# de verdade — é só o identificador da credencial no Firebase.
AUTH_CORRETOR_EMAIL_DOMAIN="corretor.antecipa.com.br"
# Imprime o link de ativação no log do servidor. Apenas para o piloto, antes de
# a entrega por WhatsApp existir. Link de senha é credencial: manter "0".
AUTH_LINK_DEBUG="0"
