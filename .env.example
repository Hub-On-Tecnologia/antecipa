BITRIX_LIST_URL="https://seu-dominio.bitrix24.com.br/rest/USER_ID/TOKEN/crm.deal.list.json"
BITRIX_WEBHOOK_URL="https://seu-dominio.bitrix24.com.br/rest/USER_ID/TOKEN/crm.deal.add.json"

# Firebase applet configurations
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
