rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }
    
    function isOwner(data) { 
      return isSignedIn() && data.userId == request.auth.uid; 
    }

    // --- Validation Blueprints ---
    function isValidPromisedCommission(data) {
      let requiredKeys = ['pvId', 'receivableId', 'amount', 'previsaoMes', 'previsaoAno', 'userId', 'status', 'stageName', 'requestedAt', 'updatedAt'];
      return data.keys().hasAll(requiredKeys) &&
             data.pvId is string && data.pvId.size() < 128 &&
             data.receivableId is string && data.receivableId.size() < 256 &&
             // Valor precisa ser positivo. Só "is number" aceitava zero e
             // negativo — o "Amount Poisoning" do security_spec.md (INV-3).
             // A planilha já descarta linha com valor <= 0, então nenhuma
             // solicitação legítima é recusada por isto.
             data.amount is number && data.amount > 0 &&
             data.previsaoMes is string &&
             data.previsaoAno is string &&
             data.userId == request.auth.uid &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.stageName is string && data.stageName.size() < 256 &&
             data.requestedAt == request.time &&
             data.updatedAt == request.time &&
             (data.keys().hasAny(['isCollateral']) ? (data.isCollateral is bool) : true) &&
             (data.keys().hasAny(['collateralFor']) ? (data.collateralFor is string && data.collateralFor.size() < 256) : true) &&
             (data.keys().hasAny(['userRole']) ? (data.userRole is string && data.userRole.size() < 128) : true) &&
             (data.keys().hasAny(['advanceType']) ? (data.advanceType is string && data.advanceType.size() < 32) : true) &&
             (data.keys().hasAny(['advanceAmount']) ? (data.advanceAmount is number && data.advanceAmount > 0) : true) &&
             (data.keys().hasAny(['bitrixDealId']) ? (data.bitrixDealId is string && data.bitrixDealId.size() < 128) : true);
    }

    function isValidUpdate(data) {
      let allowedKeys = ['status', 'stageName', 'updatedAt', 'signatureData', 'signedAt', 'userRole', 'isCollateral', 'collateralFor', 'advanceType', 'advanceAmount', 'bitrixDealId'];
      let affected = data.diff(existing()).affectedKeys();
      
      return data.userId == request.auth.uid &&
             affected.hasOnly(allowedKeys) &&
             incoming().userId == existing().userId &&
             incoming().receivableId == existing().receivableId &&
             incoming().pvId == existing().pvId &&
             // ATENÇÃO: o cliente ainda pode escrever 'approved' aqui, e isso é
             // deliberado por ora. Quem decide aprovação é o Bitrix; este campo
             // é um ESPELHO que o próprio dashboard atualiza ao ler o CRM
             // (Dashboard.tsx, sincronização de status). Bloquear aqui pararia
             // a sincronização e a tela mostraria "pendente" para sempre.
             // O fechamento correto é o servidor passar a escrever o espelho,
             // junto da correção de escopo do proxy Bitrix. Até lá, o campo
             // vale para exibição — nenhum dinheiro se move por causa dele.
             (affected.hasAny(['status']) ? (data.status in ['pending', 'approved', 'rejected']) : true) &&
             (affected.hasAny(['stageName']) ? (data.stageName is string && data.stageName.size() < 256) : true) &&
             (affected.hasAny(['signatureData']) ? (data.signatureData is map) : true) &&
             (affected.hasAny(['signedAt']) ? (data.signedAt == request.time) : true) &&
             data.updatedAt == request.time;
    }

    function isValidResubmission(data) {
      return isValidPromisedCommission(data) &&
             data.userId == existing().userId &&
             data.receivableId == existing().receivableId &&
             data.pvId == existing().pvId;
    }

    // --- Resources ---
    match /promised_commissions/{commissionId} {
      // Secure Get: Only owner can read their own records
      allow get: if isOwner(existing());
      
      // Secure List: Query MUST be filtered by userId on the client side
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Secure Create: Validate ID and strict schema
      allow create: if isSignedIn() && 
                    isValidId(commissionId) && 
                    isValidPromisedCommission(request.resource.data);
      
      // Allow Status Updates or Full Re-Submission (e.g. from Rejected state)
      allow update: if isOwner(existing()) && 
                    (isValidUpdate(incoming()) || isValidResubmission(incoming()));
      
      // Allow delete if owner. Handle non-existent doc case to avoid PERMISSION_DENIED on no-op deletes
      allow delete: if isSignedIn() && (resource == null || isOwner(resource.data));
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /access_logs/{logId} {
      allow create: if isSignedIn() && 
                    incoming().userId == request.auth.uid &&
                    incoming().timestamp == request.time;
      // No read/update/delete allowed from client for audit logs
    }

    match /access_tokens/{tokenId} {
      allow get, list, create, update, delete: if false;
    }

    // Posse do negócio no Bitrix (deal -> conta que o criou). É o que autoriza
    // ler e alterar um negócio pelo proxy /api/bitrix. Escrita e leitura só
    // pelo servidor, via Admin SDK, que ignora estas regras.
    //
    // Precisa ficar FORA do alcance do cliente: se ele pudesse escrever aqui,
    // bastaria declarar posse do negócio de outro corretor para poder abrir e
    // alterar a solicitação alheia. Foi por isso que promised_commissions, que
    // é gravável pelo cliente, não pôde servir de prova de posse.
    match /deal_owners/{dealId} {
      allow get, list, create, update, delete: if false;
    }

    // Vínculo conta Google <-> corretor. Escrito e lido apenas pelo servidor
    // via Admin SDK, que ignora estas regras. Se o cliente pudesse escrever
    // aqui, qualquer um se declararia qualquer corretor.
    match /user_bindings/{uid} {
      allow get, list, create, update, delete: if false;
    }

    match /corretor_bindings/{cpf} {
      allow get, list, create, update, delete: if false;
    }

    // Cadastro por senha aguardando o primeiro login. Guarda CPF e nome já
    // conferidos contra o MariaDB — se o cliente pudesse escrever aqui,
    // qualquer um se declararia qualquer corretor no ativar-vinculo.
    match /registro_pendente/{uid} {
      allow get, list, create, update, delete: if false;
    }
  }
}
