    replacement_chunks {
      target_content: "export default function App() {\n  const [user, setUser] = useState<string | null>(null);\n\n  const handleLogin = (userName: string) => {\n    setUser(userName);\n  };\n\n  const handleLogout = () => {\n    setUser(null);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#f8fafc] text-slate-900 font-sans selection:bg-blue-100 selection:text-blue-900 overflow-x-hidden\">\n      {/* Background Decorativo */}\n      <div className=\"fixed inset-0 overflow-hidden pointer-events-none\">\n        <div className=\"absolute -top-[10%] -left-[10%] w-[40%] h-[40%] bg-blue-100/50 blur-[120px] rounded-full\" />\n        <div className=\"absolute top-[60%] -right-[10%] w-[35%] h-[35%] bg-indigo-50/50 blur-[100px] rounded-full\" />\n      </div>\n\n      <main className=\"relative z-10 min-h-screen flex flex-col items-center justify-center p-6\">\n        <AnimatePresence mode=\"wait\">\n          {!user ? (\n            <motion.div\n              key=\"login\"\n              initial={{ opacity: 0, scale: 0.95 }}\n              animate={{ opacity: 1, scale: 1 }}\n              exit={{ opacity: 0, scale: 1.05 }}\n              transition={{ duration: 0.4, ease: [0.22, 1, 0.36, 1] }}\n              className=\"w-full\"\n            >\n              <LoginForm onLoginSuccess={handleLogin} />\n            </motion.div>\n          ) : (\n            <motion.div\n              key=\"dashboard\"\n              initial={{ opacity: 0, y: 20 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -20 }}\n              className=\"w-full max-w-4xl\"\n            >\n              <div className=\"bg-white rounded-[2rem] shadow-xl border border-slate-100 p-8 md:p-12 overflow-hidden relative\">\n                <div className=\"absolute top-0 right-0 p-8\">\n                  <Shield size={120} className=\"text-blue-50/80 -mr-8 -mt-8\" />\n                </div>\n                \n                <div className=\"relative z-10\">\n                  <div className=\"flex items-center gap-4 mb-8\">\n                    <div className=\"w-16 h-16 rounded-2xl bg-blue-600 flex items-center justify-center text-white shadow-lg shadow-blue-500/20\">\n                      <UserIcon size={32} />\n                    </div>\n                    <div>\n                      <h2 className=\"text-sm font-bold text-blue-600 uppercase tracking-widest mb-1\">Acesso Confirmado</h2>\n                      <h1 className=\"text-3xl font-extrabold text-slate-900 tracking-tight\">\n                        Ol\303\241, {user.split(\' \')[0]}!\n                      </h1>\n                    </div>\n                  </div>\n\n                  <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-12\">\n                    {[\n                      { label: \'Status da Conta\', value: \'Ativo\', color: \'text-emerald-600\', bg: \'bg-emerald-50\' },\n                      { label: \'\303\232ltimo Acesso\', value: new Date().toLocaleDateString(\'pt-BR\'), color: \'text-blue-600\', bg: \'bg-blue-50\' },\n                      { label: \'N\303\255vel de Seguran\303\247a\', value: \'M\303\241ximo\', color: \'text-indigo-600\', bg: \'bg-indigo-50\' }\n                    ].map((item, i) => (\n                      <div key={i} className={`${item.bg} p-6 rounded-2xl border border-white`}>\n                        <p className=\"text-xs font-bold text-slate-500 uppercase tracking-wider mb-1\">{item.label}</p>\n                        <p className={`text-xl font-bold ${item.color}`}>{item.value}</p>\n                      </div>\n                    ))}\n                  </div>\n\n                  <div className=\"flex flex-col md:flex-row gap-4 items-center\">\n                    <button className=\"w-full md:w-auto px-8 py-4 bg-slate-900 hover:bg-slate-800 text-white rounded-2xl font-semibold transition-all active:scale-[0.98]\">\n                      Painel de Controle\n                    </button>\n                    <button \n                      onClick={handleLogout}\n                      className=\"w-full md:w-auto px-8 py-4 bg-white border border-slate-200 hover:bg-slate-50 text-slate-600 rounded-2xl font-semibold transition-all flex items-center justify-center gap-2 active:scale-[0.98]\"\n                    >\n                      <LogOut size={20} />\n                      Sair com Seguran\303\247a\n                    </button>\n                  </div>\n                </div>\n              </div>\n            </motion.div>\n          )}\n        </AnimatePresence>\n      </main>\n\n      <footer className=\"fixed bottom-0 left-0 right-0 p-6 flex justify-between items-center z-0 pointer-events-none opacity-40\">\n        <p className=\"text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em]\">Criptografia de Ponta a Ponta</p>\n        <p className=\"text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em]\">\302\251 2026 Sistema Antecipa</p>\n      </footer>\n    </div>\n  );\n}"
      replacement_content: "export default function App() {\n  const [user, setUser] = useState<string | null>(null);\n\n  const handleLogin = (userName: string) => {\n    setUser(userName);\n  };\n\n  const handleLogout = () => {\n    setUser(null);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#0A0A0A] text-white font-sans selection:bg-white/20 selection:text-white overflow-hidden flex flex-col md:flex-row\">\n      {/* Decorative Background Elements */}\n      <div className=\"fixed top-0 right-0 p-8 z-0 pointer-events-none opacity-20 hidden md:block\">\n        <div className=\"text-[10px] font-mono text-white/40 rotate-90 origin-right tracking-widest leading-none\">\n          LAT: -23.5505 | LONG: -46.6333\n        </div>\n      </div>\n      <div className=\"fixed bottom-0 right-0 p-8 z-0 pointer-events-none opacity-20 hidden md:block\">\n        <div className=\"w-24 h-[1px] bg-white/20\"></div>\n      </div>\n\n      <AnimatePresence mode=\"wait\">\n        {!user ? (\n          <motion.div\n            key=\"login-layout\"\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            exit={{ opacity: 0 }}\n            className=\"flex flex-col md:flex-row w-full h-full min-h-screen\"\n          >\n            {/* Left Sidebar / Brand Pane */}\n            <div className=\"w-full md:w-[450px] bg-[#111111] border-r border-white/5 p-8 md:p-16 flex flex-col justify-between shrink-0\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-10 h-10 bg-white flex items-center justify-center rounded-lg shadow-[0_0_20px_rgba(255,255,255,0.1)]\">\n                  <span className=\"text-[#0A0A0A] font-black text-xl italic tracking-tighter\">A</span>\n                </div>\n                <span className=\"text-[10px] uppercase tracking-[0.3em] font-bold opacity-60\">Antecipa Portal</span>\n              </div>\n              \n              <div className=\"my-12 md:my-0\">\n                <motion.h1 \n                  initial={{ opacity: 0, y: 20 }}\n                  animate={{ opacity: 1, y: 0 }}\n                  transition={{ delay: 0.2 }}\n                  className=\"text-5xl md:text-7xl font-light leading-[1.1] mb-8 tracking-tight\"\n                >\n                  Acesso<br/><span className=\"font-semibold opacity-30 italic\">Seguro</span><br/>Interno.\n                </motion.h1>\n                <div className=\"h-1 w-12 bg-white opacity-20\"></div>\n              </div>\n\n              <div className=\"space-y-6\">\n                <div className=\"flex items-center gap-4 text-[10px] font-bold tracking-widest opacity-40\">\n                  <div className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\"></div>\n                  <span>SISTEMA DE AUTENTICA\303\207\303\203O ATIVO</span>\n                </div>\n                <p className=\"text-[10px] uppercase tracking-[0.2em] opacity-25 leading-relaxed font-medium\">\n                  Acesso restrito ao quadro de colaboradores cadastrados na base unificada.\n                </p>\n              </div>\n            </div>\n\n            {/* Main Login Pane */}\n            <div className=\"flex-1 flex items-center justify-center p-6 md:p-20 bg-[#0A0A0A]\">\n              <LoginForm onLoginSuccess={handleLogin} />\n            </div>\n          </motion.div>\n        ) : (\n          <motion.div\n            key=\"dashboard-layout\"\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            className=\"flex-1 flex flex-col items-center justify-center p-6 bg-[#0A0A0A] min-h-screen relative z-10\"\n          >\n            <div className=\"w-full max-w-5xl bg-[#111111] border border-white/5 rounded-sm p-8 md:p-16 relative overflow-hidden\">\n              {/* Absolutes for style */}\n              <div className=\"absolute top-0 right-0 p-12 opacity-[0.03]\">\n                <Shield size={320} strokeWidth={0.5} />\n              </div>\n\n              <div className=\"relative z-10\">\n                <header className=\"flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16 underline-offset-8\">\n                  <div>\n                    <span className=\"text-[10px] uppercase tracking-[0.4em] font-bold text-white/40 mb-4 block\">Dashboard de Seguran\303\247a</span>\n                    <h1 className=\"text-4xl md:text-6xl font-light\">\n                      Painel <span className=\"font-semibold\">{user.split(\' \')[0]}</span>\n                    </h1>\n                  </div>\n                  <button \n                    onClick={handleLogout}\n                    className=\"flex items-center gap-2 text-[10px] uppercase tracking-[0.2em] font-bold text-white/30 hover:text-white transition-colors py-2 px-4 border border-white/10 rounded-sm\"\n                  >\n                    <LogOut size={14} />\n                    Encerrar Sess\303\243o\n                  </button>\n                </header>\n\n                <div className=\"grid grid-cols-1 md:grid-cols-3 gap-1 mb-16 bg-white/5 border border-white/5 rounded-sm overflow-hidden\">\n                  {[\n                    { label: \'Status Operacional\', value: \'Conectado\', detail: \'ID: 882.A9\' },\n                    { label: \'Data de Acesso\', value: new Date().toLocaleDateString(\'pt-BR\'), detail: \'H: \' + new Date().toLocaleTimeString(\'pt-BR\', { hour: \'2-digit\', minute: \'2-digit\' }) },\n                    { label: \'Privil\303\251gio\', value: \'Corporativo\', detail: \'N\303\255vel 04\' }\n                  ].map((item, i) => (\n                    <div key={i} className=\"bg-[#111111] p-8 hover:bg-white/[0.02] transition-colors\">\n                      <p className=\"text-[10px] font-bold text-white/30 uppercase tracking-[0.2em] mb-4\">{item.label}</p>\n                      <p className=\"text-2xl font-light mb-1\">{item.value}</p>\n                      <p className=\"text-[9px] font-mono text-white/20 tracking-widest\">{item.detail}</p>\n                    </div>\n                  ))}\n                </div>\n\n                <div className=\"flex flex-wrap gap-4\">\n                  <button className=\"bg-white text-[#0A0A0A] px-10 py-5 text-[10px] font-bold uppercase tracking-[0.3em] hover:bg-white/90 transition-all rounded-sm flex items-center gap-3\">\n                    Configura\303\247\303\265es Gerais\n                    <Shield size={14} />\n                  </button>\n                  <button className=\"bg-white/5 border border-white/10 text-white px-10 py-5 text-[10px] font-bold uppercase tracking-[0.3em] hover:bg-white/10 transition-all rounded-sm\">\n                    Hist\303\263rico de Logs\n                  </button>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"mt-12 flex gap-12 border-t border-white/5 pt-8 w-full max-w-5xl justify-between\">\n               <div className=\"flex gap-8\">\n                 <span className=\"text-[9px] uppercase tracking-[0.2em] text-white/20 hover:text-white/40 transition-colors cursor-pointer\">Protocolos</span>\n                 <span className=\"text-[9px] uppercase tracking-[0.2em] text-white/20 hover:text-white/40 transition-colors cursor-pointer\">Seguran\303\247a</span>\n               </div>\n               <span className=\"text-[9px] uppercase tracking-[0.2em] text-white/10 font-mono\">HASH: 1uzQ...LRUtljnU</span>\n            </div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n}"
