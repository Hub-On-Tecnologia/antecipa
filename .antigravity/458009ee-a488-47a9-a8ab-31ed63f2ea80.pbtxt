        replacement_content: "import { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { LogOut, User as UserIcon, Shield } from \'lucide-react\';\nimport LoginForm from \'./components/LoginForm\';\n\nexport default function App() {\n  const [user, setUser] = useState<string | null>(null);\n\n  const handleLogin = (userName: string) => {\n    setUser(userName);\n  };\n\n  const handleLogout = () => {\n    setUser(null);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#f8fafc] text-slate-900 font-sans selection:bg-blue-100 selection:text-blue-900 overflow-x-hidden\">\n      {/* Background Decorativo */}\n      <div className=\"fixed inset-0 overflow-hidden pointer-events-none\">\n        <div className=\"absolute -top-[10%] -left-[10%] w-[40%] h-[40%] bg-blue-100/50 blur-[120px] rounded-full\" />\n        <div className=\"absolute top-[60%] -right-[10%] w-[35%] h-[35%] bg-indigo-50/50 blur-[100px] rounded-full\" />\n      </div>\n\n      <main className=\"relative z-10 min-h-screen flex flex-col items-center justify-center p-6\">\n        <AnimatePresence mode=\"wait\">\n          {!user ? (\n            <motion.div\n              key=\"login\"\n              initial={{ opacity: 0, scale: 0.95 }}\n              animate={{ opacity: 1, scale: 1 }}\n              exit={{ opacity: 0, scale: 1.05 }}\n              transition={{ duration: 0.4, ease: [0.22, 1, 0.36, 1] }}\n              className=\"w-full\"\n            >\n              <LoginForm onLoginSuccess={handleLogin} />\n            </motion.div>\n          ) : (\n            <motion.div\n              key=\"dashboard\"\n              initial={{ opacity: 0, y: 20 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -20 }}\n              className=\"w-full max-w-4xl\"\n            >\n              <div className=\"bg-white rounded-[2rem] shadow-xl border border-slate-100 p-8 md:p-12 overflow-hidden relative\">\n                <div className=\"absolute top-0 right-0 p-8\">\n                  <Shield size={120} className=\"text-blue-50/80 -mr-8 -mt-8\" />\n                </div>\n                \n                <div className=\"relative z-10\">\n                  <div className=\"flex items-center gap-4 mb-8\">\n                    <div className=\"w-16 h-16 rounded-2xl bg-blue-600 flex items-center justify-center text-white shadow-lg shadow-blue-500/20\">\n                      <UserIcon size={32} />\n                    </div>\n                    <div>\n                      <h2 className=\"text-sm font-bold text-blue-600 uppercase tracking-widest mb-1\">Acesso Confirmado</h2>\n                      <h1 className=\"text-3xl font-extrabold text-slate-900 tracking-tight\">\n                        Ol\303\241, {user.split(\' \')[0]}!\n                      </h1>\n                    </div>\n                  </div>\n\n                  <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-12\">\n                    {[\n                      { label: \'Status da Conta\', value: \'Ativo\', color: \'text-emerald-600\', bg: \'bg-emerald-50\' },\n                      { label: \'\303\232ltimo Acesso\', value: new Date().toLocaleDateString(\'pt-BR\'), color: \'text-blue-600\', bg: \'bg-blue-50\' },\n                      { label: \'N\303\255vel de Seguran\303\247a\', value: \'M\303\241ximo\', color: \'text-indigo-600\', bg: \'bg-indigo-50\' }\n                    ].map((item, i) => (\n                      <div key={i} className={`${item.bg} p-6 rounded-2xl border border-white`}>\n                        <p className=\"text-xs font-bold text-slate-500 uppercase tracking-wider mb-1\">{item.label}</p>\n                        <p className={`text-xl font-bold ${item.color}`}>{item.value}</p>\n                      </div>\n                    ))}\n                  </div>\n\n                  <div className=\"flex flex-col md:flex-row gap-4 items-center\">\n                    <button className=\"w-full md:w-auto px-8 py-4 bg-slate-900 hover:bg-slate-800 text-white rounded-2xl font-semibold transition-all active:scale-[0.98]\">\n                      Painel de Controle\n                    </button>\n                    <button \n                      onClick={handleLogout}\n                      className=\"w-full md:w-auto px-8 py-4 bg-white border border-slate-200 hover:bg-slate-50 text-slate-600 rounded-2xl font-semibold transition-all flex items-center justify-center gap-2 active:scale-[0.98]\"\n                    >\n                      <LogOut size={20} />\n                      Sair com Seguran\303\247a\n                    </button>\n                  </div>\n                </div>\n              </div>\n            </motion.div>\n          )}\n        </AnimatePresence>\n      </main>\n\n      <footer className=\"fixed bottom-0 left-0 right-0 p-6 flex justify-between items-center z-0 pointer-events-none opacity-40\">\n        <p className=\"text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em]\">Criptografia de Ponta a Ponta</p>\n        <p className=\"text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em]\">\302\251 2026 Sistema Antecipa</p>\n      </footer>\n    </div>\n  );\n}\n"
      }
      num_matches: 1
    }
  }
}
