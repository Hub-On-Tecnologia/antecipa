    instruction: "Group receivables by ID in the Dashboard and show individual installments."
    replacement_infos {
      original_chunk {
        target_content: "export default function Dashboard({ userName }: DashboardProps) {\n  const [receivables, setReceivables] = useState<Receivable[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    async function loadData() {\n      const data = await fetchReceivables(userName);\n      setReceivables(data);\n      setLoading(false);\n    }\n    loadData();\n  }, [userName]);\n\n  const totalAmount = receivables.reduce((acc, curr) => {\n    if (curr.status.toLowerCase().includes(\'pago\')) return acc;\n    const numeric = parseFloat(curr.valor.replace(/[^0-9,.-]/g, \'\').replace(\'.\', \'\').replace(\',\', \'.\'));\n    return acc + (isNaN(numeric) ? 0 : numeric);\n  }, 0);\n\n  const formatCurrency = (val: number) => {\n    return new Intl.NumberFormat(\'pt-BR\', { style: \'currency\', currency: \'BRL\' }).format(val);\n  };\n\n  if (loading) {\n    return (\n      <div className=\"flex flex-col items-center justify-center p-20 animate-pulse text-white/20\">\n        <Loader2 className=\"animate-spin mb-4\" size={48} />\n        <p className=\"text-[10px] uppercase tracking-[0.3em] font-bold\">Sincronizando Ativos...</p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-12\">\n      {/* Resumo Financeiro */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-1 bg-white/5 border border-white/5 rounded-sm overflow-hidden\">\n        <div className=\"bg-[#111111] p-10 flex flex-col justify-between group hover:bg-white/[0.02] transition-colors\">\n          <div>\n            <p className=\"text-[10px] font-bold text-white/30 uppercase tracking-[0.3em] mb-4 flex items-center gap-2\">\n              <Wallet size={12} /> Saldo Dispon\303\255vel\n            </p>\n            <h3 className=\"text-4xl md:text-5xl font-light mb-2\">{formatCurrency(totalAmount)}</h3>\n          </div>\n          <div className=\"mt-8 flex items-center gap-3 text-[10px] font-bold text-emerald-400 tracking-widest uppercase\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\"></span>\n            Pronto para Antecipa\303\247\303\243o\n          </div>\n        </div>\n        \n        <div className=\"bg-[#111111] p-10 flex flex-col justify-between group hover:bg-white/[0.02] transition-colors\">\n          <div>\n            <p className=\"text-[10px] font-bold text-white/30 uppercase tracking-[0.3em] mb-4 flex items-center gap-2\">\n              <History size={12} /> T\303\255tulos Identificados\n            </p>\n            <h3 className=\"text-4xl md:text-5xl font-light mb-2\">{receivables.length}</h3>\n          </div>\n          <div className=\"mt-8 text-[10px] font-bold text-white/20 tracking-widest uppercase\">\n            Compet\303\252ncia CR 2025\n          </div>\n        </div>\n      </div>\n\n      {/* Lista de Receb\303\255veis */}\n      <div className=\"space-y-6\">\n        <div className=\"flex items-center justify-between border-b border-white/5 pb-4\">\n          <h2 className=\"text-[10px] uppercase tracking-[0.5em] font-bold text-white/40 flex items-center gap-2\">\n            <List size={14} /> Detalhamento de Proventos\n          </h2>\n          <span className=\"text-[9px] font-mono text-white/20 uppercase tracking-tighter\">Filtro: {userName}</span>\n        </div>\n\n        {receivables.length === 0 ? (\n          <div className=\"bg-white/5 border border-white/5 rounded-sm p-12 text-center\">\n            <p className=\"text-sm text-white/30 tracking-widest italic\">Nenhum t\303\255tulo pendente localizado para este perfil.</p>\n          </div>\n        ) : (\n          <div className=\"grid gap-px bg-white/5 border border-white/5 rounded-sm overflow-hidden\">\n            {receivables.map((item, index) => (\n              <motion.div \n                key={index}\n                initial={{ opacity: 0, x: -10 }}\n                animate={{ opacity: 1, x: 0 }}\n                transition={{ delay: index * 0.05 }}\n                className=\"bg-[#111111] p-6 flex flex-col md:flex-row md:items-center justify-between gap-4 group hover:bg-white/[0.03] transition-all cursor-pointer\"\n              >\n                <div className=\"flex items-center gap-6\">\n                  <div className=\"w-12 h-12 bg-white/5 flex items-center justify-center rounded-sm text-white/40 group-hover:bg-white group-hover:text-[#0A0A0A] transition-all shrink-0\">\n                    <DollarSign size={20} />\n                  </div>\n                <div className=\"flex-1 min-w-0\">\n                  <div className=\"flex flex-wrap items-center gap-x-3 gap-y-1 mb-1\">\n                    <p className=\"text-[9px] font-mono text-white/20 tracking-[0.2em] whitespace-nowrap\">ID: {item.id}</p>\n                    {item.construtora && (\n                      <span className=\"text-[9px] px-1.5 py-0.5 bg-white/5 border border-white/5 text-white/40 rounded-sm uppercase font-bold tracking-tighter\">\n                        {item.construtora}\n                      </span>\n                    )}\n                    {item.status.toLowerCase().includes(\'pago\') ? (\n                       <span className=\"text-[9px] px-1.5 py-0.5 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 rounded-sm uppercase font-bold tracking-tighter\">\n                         Pago\n                       </span>\n                    ) : (\n                       <span className=\"text-[9px] px-1.5 py-0.5 bg-blue-500/10 border border-blue-500/20 text-blue-400 rounded-sm uppercase font-bold tracking-tighter\">\n                         Dispon\303\255vel\n                       </span>\n                    )}\n                  </div>\n                  <p className={cn(\n                    \"text-sm font-semibold tracking-wide uppercase truncate max-w-md\",\n                    item.status.toLowerCase().includes(\'pago\') && \"opacity-40\"\n                  )}>{item.cliente || item.nome}</p>\n                  <div className=\"mt-1 flex items-center gap-3\">\n                     <div className=\"flex items-center gap-1.5\">\n                       <span className=\"text-[9px] text-white/20 uppercase tracking-widest font-medium\">Previs\303\243o:</span>\n                       <span className=\"text-[9px] text-white/60 font-bold uppercase\">{item.previsaoMes}/{item.previsaoAno}</span>\n                     </div>\n                     {item.infoParcela && (\n                       <>\n                         <div className=\"w-[1px] h-2 bg-white/10\"></div>\n                         <span className=\"text-[9px] text-white/40 italic\">{item.infoParcela}</span>\n                       </>\n                     )}\n                  </div>\n                </div>\n                </div>\n                \n                <div className=\"flex items-center justify-between md:justify-end gap-10\">\n                  <div className=\"text-right\">\n                    <p className=\"text-[9px] font-bold text-white/20 uppercase tracking-[0.2em] mb-1\">Valor Bruto</p>\n                    <p className=\"text-lg font-light tracking-tight\">{item.valor}</p>\n                  </div>\n                  <button className=\"p-3 bg-white/5 rounded-full text-white/20 group-hover:text-white group-hover:bg-white/10 transition-all\">\n                    <ArrowRight size={18} />\n                  </button>\n                </div>\n              </motion.div>\n            ))}\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}"
        replacement_content: "export default function Dashboard({ userName }: DashboardProps) {\n  const [receivables, setReceivables] = useState<Receivable[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    async function loadData() {\n      const data = await fetchReceivables(userName);\n      setReceivables(data);\n      setLoading(false);\n    }\n    loadData();\n  }, [userName]);\n\n  // Agrupamento por ID\n  const grouped = receivables.reduce((acc, curr) => {\n    if (!acc[curr.id]) {\n      acc[curr.id] = {\n        id: curr.id,\n        items: [],\n        totalGroup: 0,\n        mainInfo: curr\n      };\n    }\n    acc[curr.id].items.push(curr);\n    if (!curr.status.toLowerCase().includes(\'pago\')) {\n      acc[curr.id].totalGroup += curr.valorNumeric;\n    }\n    return acc;\n  }, {} as Record<string, { id: string; items: Receivable[]; totalGroup: number; mainInfo: Receivable }>);\n\n  const groups = Object.values(grouped);\n\n  const totalAmount = receivables.reduce((acc, curr) => {\n    if (curr.status.toLowerCase().includes(\'pago\')) return acc;\n    return acc + curr.valorNumeric;\n  }, 0);\n\n  const formatCurrency = (val: number) => {\n    return new Intl.NumberFormat(\'pt-BR\', { style: \'currency\', currency: \'BRL\' }).format(val);\n  };\n\n  if (loading) {\n    return (\n      <div className=\"flex flex-col items-center justify-center p-20 animate-pulse text-white/20\">\n        <Loader2 className=\"animate-spin mb-4\" size={48} />\n        <p className=\"text-[10px] uppercase tracking-[0.3em] font-bold\">Sincronizando Ativos...</p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-12\">\n      {/* Resumo Financeiro */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-1 bg-white/5 border border-white/5 rounded-sm overflow-hidden\">\n        <div className=\"bg-[#111111] p-10 flex flex-col justify-between group hover:bg-white/[0.02] transition-colors\">\n          <div>\n            <p className=\"text-[10px] font-bold text-white/30 uppercase tracking-[0.3em] mb-4 flex items-center gap-2\">\n              <Wallet size={12} /> Total Pendente\n            </p>\n            <h3 className=\"text-4xl md:text-5xl font-light mb-2\">{formatCurrency(totalAmount)}</h3>\n          </div>\n          <div className=\"mt-8 flex items-center gap-3 text-[10px] font-bold text-emerald-400 tracking-widest uppercase\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\"></span>\n            Pronto para Antecipa\303\247\303\243o\n          </div>\n        </div>\n        \n        <div className=\"bg-[#111111] p-10 flex flex-col justify-between group hover:bg-white/[0.02] transition-colors\">\n          <div>\n            <p className=\"text-[10px] font-bold text-white/30 uppercase tracking-[0.3em] mb-4 flex items-center gap-2\">\n              <History size={12} /> Negocia\303\247\303\265es Ativas\n            </p>\n            <h3 className=\"text-4xl md:text-5xl font-light mb-2\">{groups.length}</h3>\n          </div>\n          <div className=\"mt-8 text-[10px] font-bold text-white/20 tracking-widest uppercase\">\n            {receivables.length} Parcelas Identificadas\n          </div>\n        </div>\n      </div>\n\n      {/* Lista de Receb\303\255veis Agrupados */}\n      <div className=\"space-y-8\">\n        <div className=\"flex items-center justify-between border-b border-white/5 pb-4\">\n          <h2 className=\"text-[10px] uppercase tracking-[0.5em] font-bold text-white/40 flex items-center gap-2\">\n            <List size={14} /> Detalhamento por PV\n          </h2>\n          <span className=\"text-[9px] font-mono text-white/20 uppercase tracking-tighter\">Filtro: {userName}</span>\n        </div>\n\n        {groups.length === 0 ? (\n          <div className=\"bg-white/5 border border-white/5 rounded-sm p-12 text-center\">\n            <p className=\"text-sm text-white/30 tracking-widest italic\">Nenhum t\303\255tulo pendente localizado para este perfil.</p>\n          </div>\n        ) : (\n          <div className=\"space-y-6\">\n            {groups.map((group, gIdx) => (\n              <motion.div \n                key={group.id}\n                initial={{ opacity: 0, y: 10 }}\n                animate={{ opacity: 1, y: 0 }}\n                transition={{ delay: gIdx * 0.1 }}\n                className=\"bg-[#111111] border border-white/5 rounded-sm overflow-hidden\"\n              >\n                {/* Header do Grupo (PV) */}\n                <div className=\"p-6 border-b border-white/5 bg-white/[0.02] flex flex-col md:flex-row justify-between items-start md:items-center gap-4\">\n                  <div className=\"flex items-center gap-4\">\n                    <div className=\"w-10 h-10 bg-white/5 flex items-center justify-center rounded-sm text-white/60\">\n                      <History size={18} />\n                    </div>\n                    <div>\n                      <div className=\"flex items-center gap-3 mb-0.5\">\n                        <span className=\"text-[9px] font-mono text-white/40 uppercase tracking-widest\">ID PV: {group.id}</span>\n                        <span className=\"text-[9px] px-1.5 py-0.5 bg-blue-500/10 text-blue-400 font-bold border border-blue-500/20 rounded-sm uppercase\">{group.mainInfo.construtora}</span>\n                      </div>\n                      <h4 className=\"text-sm font-bold uppercase tracking-wide\">{group.mainInfo.cliente || group.mainInfo.nome}</h4>\n                    </div>\n                  </div>\n                  <div className=\"text-right flex flex-col items-end\">\n                    <p className=\"text-[9px] font-bold text-white/30 uppercase tracking-[0.2em] mb-1\">Total Pendente (Negocia\303\247\303\243o)</p>\n                    <p className=\"text-xl font-light\">{formatCurrency(group.totalGroup)}</p>\n                  </div>\n                </div>\n\n                {/* Lista de Parcelas dentro do Grupo */}\n                <div className=\"divide-y divide-white/5\">\n                  {group.items.map((item, iIdx) => {\n                    const isPago = item.status.toLowerCase().includes(\'pago\');\n                    return (\n                      <div \n                        key={iIdx}\n                        className={cn(\n                          \"px-6 py-4 flex flex-col md:flex-row md:items-center justify-between gap-4 transition-colors\",\n                          isPago ? \"bg-black/20 opacity-40\" : \"hover:bg-white/[0.01]\"\n                        )}\n                      >\n                        <div className=\"flex items-center gap-4 flex-1\">\n                          <div className={cn(\n                            \"w-1 h-8 rounded-full\",\n                            isPago ? \"bg-white/10\" : \"bg-blue-500/40 shadow-[0_0_10px_rgba(59,130,246,0.2)]\"\n                          )} />\n                          <div className=\"min-w-0\">\n                            <div className=\"flex items-center gap-3\">\n                              <span className=\"text-[10px] font-bold uppercase tracking-widest text-white/60\">\n                                Parcela {iIdx + 1}\n                              </span>\n                              {item.valorOriginalP && !isPago && (\n                                <span className=\"text-[9px] text-white/30 italic\">{item.valorOriginalP}</span>\n                              )}\n                              {isPago && (\n                                <span className=\"text-[9px] font-bold uppercase text-emerald-500/60 tracking-wider flex items-center gap-1\">\n                                  \342\234\223 Quitado\n                                </span>\n                              )}\n                            </div>\n                            <div className=\"flex items-center gap-2 mt-0.5 text-[9px] text-white/20 uppercase tracking-widest\">\n                               <span>Vencimento Estimado:</span>\n                               <span className=\"text-white/40 font-bold\">{item.previsaoMes}/{item.previsaoAno}</span>\n                            </div>\n                          </div>\n                        </div>\n\n                        <div className=\"flex items-center justify-between md:justify-end gap-12\">\n                          <div className=\"text-right\">\n                            <p className=\"text-[9px] font-bold text-white/20 uppercase tracking-[0.2em] mb-0.5\">Valor da Parcela</p>\n                            <p className={cn(\n                              \"text-base font-semibold tracking-tight\",\n                              isPago ? \"text-white/40 line-through\" : \"text-white\"\n                            )}>{item.valor}</p>\n                          </div>\n                          {!isPago && (\n                            <button className=\"p-2.5 bg-white/5 border border-white/10 rounded-sm text-white/30 hover:text-white hover:bg-white/10 transition-all\">\n                              <ArrowRight size={14} />\n                            </button>\n                          )}\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n              </motion.div>\n            ))}\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
