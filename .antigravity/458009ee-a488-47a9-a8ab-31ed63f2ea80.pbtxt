    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { normalizeCPF, normalizeDate, normalizeName } from \'../lib/utils\';\n\nconst SHEET_ID = \'1uzQAAUN3dbmBK7p14cBTywTYuG3PNLiZVJtLRUtljnU\';\nconst TAB_NAME = \'usu\303\241rios\';\nconst URL = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:json&sheet=${encodeURIComponent(TAB_NAME)}`;\n\nexport interface UserData {\n  nome: string;\n  dataNascimento: string;\n  cpf: string;\n}\n\nexport async function fetchUsers(): Promise<UserData[]> {\n  try {\n    const response = await fetch(URL);\n    const text = await response.text();\n    \n    // O Google Sheets gviz retorna um JSON \"sujo\" com prefixo e sufixo\n    const jsonData = JSON.parse(text.substring(47, text.length - 2));\n    \n    const rows = jsonData.table.rows;\n    return rows.map((row: any) => {\n      // Coluna D (index 3), G (index 6), N (index 13)\n      const nomeCell = row.c[3]?.v || \'\';\n      const dataCell = row.c[6]?.f || row.c[6]?.v || \'\'; // .f cont\303\251m o valor formatado (m\303\241scara)\n      const cpfCell = row.c[13]?.f || row.c[13]?.v || \'\';\n\n      return {\n        nome: String(nomeCell),\n        dataNascimento: String(dataCell),\n        cpf: String(cpfCell)\n      };\n    });\n  } catch (error) {\n    console.error(\'Erro ao buscar dados da planilha:\', error);\n    return [];\n  }\n}\n\nexport async function authenticateUser(nome: string, dataNascimento: string, cpf: string): Promise<boolean> {\n  const users = await fetchUsers();\n  \n  const targetNome = normalizeName(nome);\n  const targetData = normalizeDate(dataNascimento);\n  const targetCPF = normalizeCPF(cpf);\n\n  return users.some(user => {\n    return (\n      normalizeName(user.nome) === targetNome &&\n      normalizeDate(user.dataNascimento) === targetData &&\n      normalizeCPF(user.cpf) === targetCPF\n    );\n  });\n}\n"
    }
