    replacement_chunks {
      target_content: "const TAB_NAME = \'usu\303\241rios\';\nconst URL = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:json&sheet=${encodeURIComponent(TAB_NAME)}`;\n\nexport interface UserData {\n  nome: string;\n  dataNascimento: string;\n  cpf: string;\n}\n\nexport async function fetchUsers(): Promise<UserData[]> {\n  try {\n    const response = await fetch(URL);\n    const text = await response.text();\n    \n    // O Google Sheets gviz retorna um JSON \"sujo\" com prefixo e sufixo\n    const jsonData = JSON.parse(text.substring(47, text.length - 2));\n    \n    const rows = jsonData.table.rows;\n    return rows.map((row: any) => {\n      // Coluna D (index 3), G (index 6), N (index 13)\n      const nomeCell = row.c[3]?.v || \'\';\n      const dataCell = row.c[6]?.f || row.c[6]?.v || \'\'; // .f cont\303\251m o valor formatado (m\303\241scara)\n      const cpfCell = row.c[13]?.f || row.c[13]?.v || \'\';\n\n      return {\n        nome: String(nomeCell),\n        dataNascimento: String(dataCell),\n        cpf: String(cpfCell)\n      };\n    });\n  } catch (error) {\n    console.error(\'Erro ao buscar dados da planilha:\', error);\n    return [];\n  }\n}\n\nexport async function authenticateUser(nome: string, dataNascimento: string, cpf: string): Promise<boolean> {"
      replacement_content: "const TAB_NAME = \'usu\303\241rios\';\nconst TAB_CR = \'CR 2025\';\n\nexport interface UserData {\n  nome: string;\n  dataNascimento: string;\n  cpf: string;\n}\n\nexport interface Receivable {\n  id: string;\n  nome: string;\n  valor: string;\n}\n\nasync function fetchFromSheet(tab: string): Promise<any> {\n  const url = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:json&sheet=${encodeURIComponent(tab)}`;\n  const response = await fetch(url);\n  const text = await response.text();\n  return JSON.parse(text.substring(47, text.length - 2));\n}\n\nexport async function fetchUsers(): Promise<UserData[]> {\n  try {\n    const jsonData = await fetchFromSheet(TAB_NAME);\n    const rows = jsonData.table.rows;\n    return rows.map((row: any) => {\n      const nomeCell = row.c[3]?.v || \'\';\n      const dataCell = row.c[6]?.f || row.c[6]?.v || \'\';\n      const cpfCell = row.c[13]?.f || row.c[13]?.v || \'\';\n\n      return {\n        nome: String(nomeCell),\n        dataNascimento: String(dataCell),\n        cpf: String(cpfCell)\n      };\n    });\n  } catch (error) {\n    console.error(\'Erro ao buscar usu\303\241rios:\', error);\n    return [];\n  }\n}\n\nexport async function fetchReceivables(userName: string): Promise<Receivable[]> {\n  try {\n    const jsonData = await fetchFromSheet(TAB_CR);\n    const rows = jsonData.table.rows;\n    const searchName = normalizeName(userName);\n\n    return rows\n      .map((row: any) => {\n        // Coluna A (0) -> ID, Coluna J (9) -> Nome, Coluna T (19) -> Valor\n        const id = row.c[0]?.v || \'\';\n        const nome = row.c[9]?.v || \'\';\n        const valor = row.c[19]?.f || row.c[19]?.v || \'0,00\';\n\n        return {\n          id: String(id),\n          nome: String(nome),\n          valor: String(valor)\n        };\n      })\n      .filter((item: Receivable) => normalizeName(item.nome) === searchName);\n  } catch (error) {\n    console.error(\'Erro ao buscar receb\303\255veis:\', error);\n    return [];\n  }\n}\n\nexport async function authenticateUser(nome: string, dataNascimento: string, cpf: string): Promise<boolean> {"
    }
