  file_change {
    absolute_path_uri: "file:///src/services/sheetsService.ts"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "export interface Receivable {\n  id: string;\n  nome: string;\n  valor: string;\n  construtora: string;\n  cliente: string;\n  previsaoMes: string;\n  previsaoAno: string;\n}\n\nexport async function fetchReceivables(userName: string): Promise<Receivable[]> {\n  try {\n    const jsonData = await fetchFromSheet(TAB_CR);\n    const rows = jsonData.table.rows;\n    const searchName = normalizeName(userName);\n\n    return rows\n      .map((row: any) => {\n        // Coluna A (0) -> ID\n        // Coluna G (6) -> Construtora\n        // Coluna H (7) -> Cliente\n        // Coluna J (9) -> Nome\n        // Coluna T (19) -> Valor\n        // Coluna V (21) -> M\303\252s\n        // Coluna W (22) -> Ano\n        \n        const id = row.c[0]?.v || \'\';\n        const construtora = row.c[6]?.v || \'\';\n        const cliente = row.c[7]?.v || \'\';\n        const nome = row.c[9]?.v || \'\';\n        const valorRaw = row.c[19]?.v || 0;\n        const valorStr = row.c[19]?.f || row.c[19]?.v || \'0,00\';\n        const previsaoMes = row.c[21]?.v || \'\';\n        const previsaoAno = row.c[22]?.v || \'\';\n\n        return {\n          id: String(id),\n          nome: String(nome),\n          valor: String(valorStr),\n          valorNumeric: Number(valorRaw),\n          construtora: String(construtora),\n          cliente: String(cliente),\n          previsaoMes: String(previsaoMes),\n          previsaoAno: String(previsaoAno)\n        };\n      })\n      .filter((item: any) => {\n        const matchesName = normalizeName(item.nome) === searchName;\n        const isNotZero = item.valorNumeric !== 0;\n        return matchesName && isNotZero;\n      });\n  } catch (error) {\n    console.error(\'Erro ao buscar receb\303\255veis:\', error);\n    return [];\n  }\n}"
      replacement_content: "export interface Receivable {\n  id: string;\n  nome: string;\n  valor: string;\n  valorNumeric: number;\n  construtora: string;\n  cliente: string;\n  previsaoMes: string;\n  previsaoAno: string;\n  infoParcela: string;\n  status: string;\n}\n\nexport async function fetchReceivables(userName: string): Promise<Receivable[]> {\n  try {\n    const jsonData = await fetchFromSheet(TAB_CR);\n    const rows = jsonData.table.rows;\n    const searchName = normalizeName(userName);\n\n    return rows\n      .map((row: any) => {\n        // Coluna A (0) -> ID\n        // Coluna G (6) -> Construtora\n        // Coluna H (7) -> Cliente\n        // Coluna J (9) -> Nome\n        // Coluna P (15) -> Info Parcela / Valor Total\n        // Coluna Q (16) -> Poss\303\255vel Status (Pago/Aberto)\n        // Coluna T (19) -> Valor\n        // Coluna V (21) -> M\303\252s\n        // Coluna W (22) -> Ano\n        \n        const id = row.c[0]?.v || \'\';\n        const construtora = row.c[6]?.v || \'\';\n        const cliente = row.c[7]?.v || \'\';\n        const nome = row.c[9]?.v || \'\';\n        const infoParcela = row.c[15]?.v || \'\';\n        const status = row.c[16]?.v || \'\';\n        const valorRaw = row.c[19]?.v || 0;\n        const valorStr = row.c[19]?.f || row.c[19]?.v || \'0,00\';\n        const previsaoMes = row.c[21]?.v || \'\';\n        const previsaoAno = row.c[22]?.v || \'\';\n\n        return {\n          id: String(id),\n          nome: String(nome),\n          valor: String(valorStr),\n          valorNumeric: Number(valorRaw),\n          construtora: String(construtora),\n          cliente: String(cliente),\n          previsaoMes: String(previsaoMes),\n          previsaoAno: String(previsaoAno),\n          infoParcela: String(infoParcela),\n          status: String(status)\n        };\n      })\n      .filter((item: any) => {\n        const matchesName = normalizeName(item.nome) === searchName;\n        const isNotZero = item.valorNumeric !== 0;\n        return matchesName && isNotZero;\n      });\n  } catch (error) {\n    console.error(\'Erro ao buscar receb\303\255veis:\', error);\n    return [];\n  }\n}"
    }
    instruction: "Update Receivable interface and fetchReceivables to include parcel info from column P and status from column Q."
  }
}
