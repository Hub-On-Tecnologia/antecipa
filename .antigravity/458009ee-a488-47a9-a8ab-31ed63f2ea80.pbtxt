  }
  file_change {
    absolute_path_uri: "file:///src/services/bitrixService.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { Receivable } from \'./sheetsService\';\n\nconst BITRIX_ADD_DEAL_URL = \'https://hubnogueira.bitrix24.com.br/rest/382/tz0e5k2s7a44szbv/crm.deal.add.json\';\n\nexport async function createBitrixAdvancementDeal(userName: string, receivables: Receivable[], isTotal: boolean = false) {\n  try {\n    const totalValue = receivables.reduce((acc, curr) => {\n      const numeric = parseFloat(curr.valor.replace(/[^0-9,.-]/g, \'\').replace(\'.\', \'\').replace(\',\', \'.\'));\n      return acc + (isNaN(numeric) ? 0 : numeric);\n    }, 0);\n\n    const formatCurrency = (val: number) => {\n      return new Intl.NumberFormat(\'pt-BR\', { style: \'currency\', currency: \'BRL\' }).format(val);\n    };\n\n    // Montando o PV (UF_CRM_1758140731010)\n    // Se for total, usamos o ID da primeira ou uma lista. Se for um, usamos o ID dele.\n    const pvValue = isTotal ? receivables.map(r => r.id).join(\', \') : receivables[0].id;\n\n    // Montando o texto bonito para COMMENTS\n    let comments = `[B]SOLICITA\303\207\303\203O DE ANTECIPA\303\207\303\203O - PORTAL[/B]\\n`;\n    comments += `------------------------------------------\\n`;\n    comments += `[B]Usu\303\241rio:[/B] ${userName}\\n`;\n    comments += `[B]Tipo sugerido:[/B] ${isTotal ? \'Antecipa\303\247\303\243o Total\' : \'Antecipa\303\247\303\243o Parcial\'}\\n`;\n    comments += `[B]Valor Total Solicitado:[/B] ${formatCurrency(totalValue)}\\n\\n`;\n    \n    comments += `[B]DETALHAMENTO DOS RECEB\303\215VEIS:[/B]\\n`;\n    receivables.forEach((r, idx) => {\n      comments += `[B]Item ${idx + 1}:[/B]\\n`;\n      comments += `- ID/PV: ${r.id}\\n`;\n      comments += `- Construtora: ${r.construtora}\\n`;\n      comments += `- Cliente: ${r.cliente}\\n`;\n      comments += `- Valor Parcela: ${r.valor}\\n`;\n      comments += `- Previs\303\243o: ${r.previsaoMes}/${r.previsaoAno}\\n`;\n      comments += `- Info Parcela: ${r.infoParcela}\\n`;\n      comments += `- Status na Planilha: ${r.status}\\n`;\n      comments += `------------------------------------------\\n`;\n    });\n\n    const payload = {\n      fields: {\n        TITLE: `Antecipa\303\247\303\243o - ${userName} - ${pvValue}`,\n        OPPORTUNITY: totalValue,\n        CURRENCY_ID: \"BRL\",\n        COMMENTS: comments,\n        UF_CRM_1758140731010: pvValue, // Campo de PV\n        SOURCE_ID: \"WEB\",\n        // Adicionando outros campos da planilha como campos de usu\303\241rio se necess\303\241rio futuramente\n      }\n    };\n\n    const response = await fetch(BITRIX_ADD_DEAL_URL, {\n      method: \'POST\',\n      headers: {\n        \'Content-Type\': \'application/json\'\n      },\n      body: JSON.stringify(payload)\n    });\n\n    if (!response.ok) {\n      throw new Error(\'Falha ao enviar para o Bitrix24\');\n    }\n\n    return await response.json();\n  } catch (error) {\n    console.error(\'Erro no Bitrix Service:\', error);\n    throw error;\n  }\n}\n"
    }
    diff {
      unified_diff {
        lines {
          text: "import { Receivable } from \'./sheetsService\';"
