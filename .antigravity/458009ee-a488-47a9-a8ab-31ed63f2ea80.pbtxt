  file_change {
    absolute_path_uri: "file:///src/services/sheetsService.ts"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "export interface Receivable {\n  id: string;\n  nome: string;\n  valor: string;\n  valorNumeric: number; // mantendo para o filtro\n  construtora: string;\n  cliente: string;\n  previsaoMes: string;\n  previsaoAno: string;\n  infoParcela: string;\n  status: string;\n}\n\nasync function fetchFromSheet(tab: string): Promise<any> {\n  const url = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:json&sheet=${encodeURIComponent(tab)}`;\n  const response = await fetch(url);\n  const text = await response.text();\n  return JSON.parse(text.substring(47, text.length - 2));\n}\n\nexport async function fetchUsers(): Promise<UserData[]> {\n  try {\n    const jsonData = await fetchFromSheet(TAB_NAME);\n    const rows = jsonData.table.rows;\n    return rows.map((row: any) => {\n      const nomeCell = row.c[3]?.v || \'\';\n      const dataCell = row.c[6]?.f || row.c[6]?.v || \'\';\n      const cpfCell = row.c[13]?.f || row.c[13]?.v || \'\';\n\n      return {\n        nome: String(nomeCell),\n        dataNascimento: String(dataCell),\n        cpf: String(cpfCell)\n      };\n    });\n  } catch (error) {\n    console.error(\'Erro ao buscar usu\303\241rios:\', error);\n    return [];\n  }\n}\n\nexport async function fetchReceivables(userName: string): Promise<Receivable[]> {\n  try {\n    const jsonData = await fetchFromSheet(TAB_CR);\n    const rows = jsonData.table.rows;\n    const searchName = normalizeName(userName);\n\n    return rows\n      .map((row: any) => {\n        // Coluna A (0) -> ID\n        // Coluna G (6) -> Construtora\n        // Coluna H (7) -> Cliente\n        // Coluna J (9) -> Nome\n        // Coluna T (19) -> Valor\n        // Coluna V (21) -> M\303\252s\n        // Coluna W (22) -> Ano\n        \n        const id = row.c[0]?.v || \'\';\n        const construtora = row.c[6]?.v || \'\';\n        const cliente = row.c[7]?.v || \'\';\n        const nome = row.c[9]?.v || \'\';\n        const infoParcela = row.c[15]?.v || \'\';\n        const status = row.c[16]?.v || \'\';\n        const valorRaw = row.c[19]?.v || 0;\n        const valorStr = row.c[19]?.f || row.c[19]?.v || \'0,00\';\n        const previsaoMes = row.c[21]?.v || \'\';\n        const previsaoAno = row.c[22]?.v || \'\';\n\n        return {\n          id: String(id),\n          nome: String(nome),\n          valor: String(valorStr),\n          valorNumeric: Number(valorRaw),\n          construtora: String(construtora),\n          cliente: String(cliente),\n          previsaoMes: String(previsaoMes),\n          previsaoAno: String(previsaoAno),\n          infoParcela: String(infoParcela),\n          status: String(status)\n        };\n      })\n      .filter((item: any) => {\n        const matchesName = normalizeName(item.nome) === searchName;\n        const isNotZero = item.valorNumeric !== 0;\n        return matchesName && isNotZero;\n      });\n  } catch (error) {\n    console.error(\'Erro ao buscar receb\303\255veis:\', error);\n    return [];\n  }\n}"
      replacement_content: "export interface Receivable {\n  id: string;\n  nome: string;\n  valor: string;\n  valorNumeric: number;\n  valorOriginalP: string; // Coluna P: Valor total ou \"parcelado\"\n  construtora: string;\n  cliente: string;\n  previsaoMes: string;\n  previsaoAno: string;\n  infoParcela: string; // Coluna P? O usu\303\241rio disse que P \303\251 valor/parcelado. Vou renomear para clareza.\n  status: string;\n}\n\nasync function fetchFromSheet(tab: string): Promise<any> {\n  const url = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/gviz/tq?tqx=out:json&sheet=${encodeURIComponent(tab)}`;\n  const response = await fetch(url);\n  const text = await response.text();\n  return JSON.parse(text.substring(47, text.length - 2));\n}\n\nexport async function fetchUsers(): Promise<UserData[]> {\n  try {\n    const jsonData = await fetchFromSheet(TAB_NAME);\n    const rows = jsonData.table.rows;\n    return rows.map((row: any) => {\n      const nomeCell = row.c[3]?.v || \'\';\n      const dataCell = row.c[6]?.f || row.c[6]?.v || \'\';\n      const cpfCell = row.c[13]?.f || row.c[13]?.v || \'\';\n\n      return {\n        nome: String(nomeCell),\n        dataNascimento: String(dataCell),\n        cpf: String(cpfCell)\n      };\n    });\n  } catch (error) {\n    console.error(\'Erro ao buscar usu\303\241rios:\', error);\n    return [];\n  }\n}\n\nexport async function fetchReceivables(userName: string): Promise<Receivable[]> {\n  try {\n    const jsonData = await fetchFromSheet(TAB_CR);\n    const rows = jsonData.table.rows;\n    const searchName = normalizeName(userName);\n\n    return rows\n      .map((row: any) => {\n        // Coluna A (0) -> ID\n        // Coluna G (6) -> Construtora\n        // Coluna H (7) -> Cliente\n        // Coluna J (9) -> Nome\n        // Coluna P (15) -> Valor Original / \"Parcelado\"\n        // Coluna Q (16) -> Status (Pago/...)\n        // Coluna T (19) -> Valor da Parcela/Receb\303\255vel\n        // Coluna V (21) -> M\303\252s\n        // Coluna W (22) -> Ano\n        \n        const id = row.c[0]?.v || \'\';\n        const construtora = row.c[6]?.v || \'\';\n        const cliente = row.c[7]?.v || \'\';\n        const nome = row.c[9]?.v || \'\';\n        const valorOriginalP = row.c[15]?.f || row.c[15]?.v || \'\'; // Coluna P\n        const status = row.c[16]?.v || \'\';\n        const valorRaw = row.c[19]?.v || 0;\n        const valorStr = row.c[19]?.f || row.c[19]?.v || \'0,00\';\n        const previsaoMes = row.c[21]?.v || \'\';\n        const previsaoAno = row.c[22]?.v || \'\';\n\n        return {\n          id: String(id),\n          nome: String(nome),\n          valor: String(valorStr),\n          valorNumeric: Number(valorRaw),\n          valorOriginalP: String(valorOriginalP),\n          construtora: String(construtora),\n          cliente: String(cliente),\n          previsaoMes: String(previsaoMes),\n          previsaoAno: String(previsaoAno),\n          infoParcela: String(valorOriginalP), // Mapeando P aqui tamb\303\251m para compatibilidade\n          status: String(status)\n        };\n      })\n      .filter((item: any) => {\n        const matchesName = normalizeName(item.nome) === searchName;\n        const isNotZero = item.valorNumeric !== 0;\n        return matchesName && isNotZero;\n      });\n  } catch (error) {\n    console.error(\'Erro ao buscar receb\303\255veis:\', error);\n    return [];\n  }\n}"
    }
